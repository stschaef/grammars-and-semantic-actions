-- Tokens of the STLC surface syntax, with one-step-reducing equality.
open import Cubical.Foundations.Prelude
import Cubical.Data.Sum as Sum
import Cubical.Data.Empty as Empty
import Cubical.Data.Equality as Eq

module Examples.Theory.STLC.Tokens where

data Tok : Type ℓ-zero where
  kbool knat karr kprod klist ktrue kfalse kif kthen kelse kzero ksuc knatrec klam kcolon kdot kapp kpair kfst ksnd knil kcons kfoldr klet kassign kin vf vg vn vx vxs : Tok

-- Not `sectionDiscrete _ code _ discreteℕ`: a derivation must reduce to
-- `inl Eq.refl` in one step or the tests exhaust memory.
